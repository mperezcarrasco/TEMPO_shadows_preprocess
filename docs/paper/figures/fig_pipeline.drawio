<mxfile host="app.diagrams.net">
  <diagram id="pipeline" name="Page-1">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="in_l1b" value="&lt;b&gt;TEMPO L1B (V04)&lt;/b&gt;&lt;br&gt;band_290_490_nm&lt;br&gt;&lt;font size=&quot;1&quot;&gt;RGB composite&lt;br&gt;SZA, SAA, VZA, VAA&lt;br&gt;cloud_top_height&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="120" y="40" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="in_l2" value="&lt;b&gt;TEMPO CLDO4 L2 (V04)&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;cloud_fraction (ECF)&lt;br&gt;cloud_pressure (OCP), surface_pressure&lt;br&gt;terrain_height, latitude / longitude&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="470" y="40" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="merge" value="&lt;b&gt;Per-scan mode only:&lt;/b&gt; concatenate granule arrays along mirror_step axis (run_scan.py)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="255" y="190" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="st_a" value="&lt;b&gt;(a) Effective cloud height&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;L1B CTH where valid; else hypsometric from OCP:&lt;br&gt;h = H ln(p_sfc / p_cld), cap 16 km; enlarge by (1 + C), C = 0.5&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="255" y="280" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="st_b" value="&lt;b&gt;(b) Vectorised DARCLOS projection&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;source pixels: ECF &amp;#8805; 0.30; solar + viewing displacement&lt;br&gt;to geodetic shadow position (all pixels in one NumPy call)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="255" y="390" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="st_c" value="&lt;b&gt;(c) Nearest-pixel lookup&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;batched cKDTree query in spherical ECEF coordinates&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="255" y="500" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="st_d" value="&lt;b&gt;(d) Bresenham line rasterisation&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;cloud pixel &amp;#8594; shadow tip; non-cloud pixels on the line&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="255" y="600" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pcsf" value="&lt;b&gt;PCSF&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;Potential Cloud Shadow Flag&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="305" y="700" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="st_e" value="&lt;b&gt;(e) Radiometric refinement&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;ACSF = PCSF &amp;#8743; ECF &amp;lt; 0.05&lt;br&gt;(single-wavelength surrogate at 466 nm)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="255" y="790" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="acsf" value="&lt;b&gt;ACSF&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;Actual Cloud Shadow Flag&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="305" y="900" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="out" value="&lt;b&gt;Outputs (per granule or per scan)&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;RGB GeoTIFF (EPSG:4326) + shapefiles:&lt;br&gt;clouds / potential_shadows / actual_shadows&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="255" y="990" width="320" height="70" as="geometry" />
